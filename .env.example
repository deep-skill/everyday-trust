# Local web/BFF. Never copy production secrets into this file.
API_BASE_URL=http://127.0.0.1:4000
API_SERVICE_TOKEN=local-development-service-token-only
WEB_DATABASE_URL=postgres://postgres:local-development-only@127.0.0.1:54329/everyday_trust_dev

# Optional Cognito configuration. Anonymous queries work without these values.
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
SESSION_ENCRYPTION_KEY=

# Production requires verified TLS to PostgreSQL.
DATABASE_CA_FILE=
