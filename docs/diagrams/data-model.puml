@startuml data-model
title Modelo lógico de resultados guardados
hide circle
skinparam linetype ortho
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam shadowing false

entity AccountProfile {
  * id : identifier <<PK>>
  --
  * identity_issuer : text
  * identity_subject : text
  * created_at : timestamp
}
entity SavedCase {
  * id : identifier <<PK>>
  --
  * owner_id : identifier <<FK>>
  * title : sanitized text
  * resume_summary : sanitized text
  * verdict : risk category
  * baseline_verdict : risk category
  * risk_origin : category
  * scam_type : pattern hypothesis
  * rules_score : integer 0..100
  * analysis_mode : category
  * coverage : check summary
  * analyzed_at : timestamp
  * schema_version : text
  * policy_version : text
  * created_at : timestamp
}
entity CaseEvidence {
  * id : identifier <<PK>>
  --
  * case_id : identifier <<FK>>
  source_version_id : identifier <<FK>>
  * signal_id : text
  * severity : category
  * explanation : sanitized text
  * checked_at : timestamp
  * check_status : category
  domain : public domain
}
entity Source {
  * id : identifier <<PK>>
  --
  * name : text
  * kind : category
  * public_url : URL
}
entity SourceVersion {
  * id : identifier <<PK>>
  --
  * source_id : identifier <<FK>>
  * fetched_at : timestamp
  * content_digest : text
  * status : category
  reviewed_at : timestamp
}
entity QuotaBucket {
  * subject_key : pseudonymous key <<PK>>
  * operation : text <<PK>>
  * window_start : timestamp <<PK>>
  --
  * count : integer
  * expires_at : timestamp
}

entity Review {
  * id : identifier <<PK>>
  --
  * case_id : identifier <<UNIQUE>>
  owner_id : identifier <<FK>>
  * kind : query or demo
  * rating : integer 1..5
  comment : private text, max 500
  * created_at : timestamp
}
entity DailyMetric {
  * day : date <<PK>>
  * kind : site, query or demo <<PK>>
  * metric : category <<PK>>
  --
  * count : integer
}
AccountProfile |o--o{ Review : optional owner, delete cascade
Review ..> DailyMetric : anonymous aggregates
note bottom of Review
  Private comments expire after 30 days.
  No original analyzed message.
  Case id has no FK to expiring cases.
end note

AccountProfile ||--o{ SavedCase : owns
SavedCase ||--o{ CaseEvidence : contains
Source ||--o{ SourceVersion : versions
SourceVersion |o--o{ CaseEvidence : supports

note bottom of AccountProfile
  UNIQUE(identity_issuer, identity_subject)
  Credentials stay with the identity provider.
end note
note bottom of SavedCase
  No original message, phone numbers,
  email addresses or full conversation.
end note
note bottom of QuotaBucket
  Independent operational counters.
  Expiring keys, atomic updates.
end note
@enduml
