@startuml
title <size:24>Contenedores lógicos del verificador de mensajes</size>

set separator none
left to right direction
skinparam ranksep 60
skinparam nodesep 25
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Container
  .Element-RWxlbWVudCxDb250YWluZXI= {
    BackgroundColor: #dbeafe;
    LineColor: #99a3b1;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #0f172a;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Database
  .Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U= {
    BackgroundColor: #dcfce7;
    LineColor: #9ab0a1;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #0f172a;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #1e3a8a;
    LineColor: #152860;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0= {
    BackgroundColor: #1d4ed8;
    LineColor: #143697;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Verificador de mensajes
  .Boundary-VmVyaWZpY2Fkb3IgZGUgbWVuc2FqZXM= {
    BackgroundColor: #ffffff;
    LineColor: #143697;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

person "==Persona que consulta\n<size:16>[Person]</size>\n\nEvalúa un mensaje y decide su siguiente acción, con o sin cuenta." <<Element-RWxlbWVudCxQZXJzb24=>> as Personaqueconsulta
person "==Operador\n<size:16>[Person]</size>\n\nMantiene fuentes, costos y funcionamiento sin leer mensajes en logs." <<Element-RWxlbWVudCxQZXJzb24=>> as Operador
rectangle "==Servicio de identidad\n<size:16>[Software System]</size>\n\nRegistro, confirmación, recuperación y acceso con Amazon Cognito." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Serviciodeidentidad
rectangle "==Proveedor de IA\n<size:16>[Software System]</size>\n\nMuse Spark 1.3 Contributor con mensaje completo y evidencia; piloto interno, publicación pendiente." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as ProveedordeIA
rectangle "==Sitios consultados\n<size:16>[Software System]</size>\n\nRaíz pública mediante HEAD, DNS/IP fijados, redirecciones limitadas; sin HTML ni JavaScript." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Sitiosconsultados
rectangle "==Fuentes verificables\n<size:16>[Software System]</size>\n\nDominios oficiales, Phishing.Database y RDAP; otras fuentes por integrar." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Fuentesverificables

rectangle "Verificador de mensajes\n<size:16>[Software System]</size>" <<Boundary-VmVyaWZpY2Fkb3IgZGUgbWVuc2FqZXM=>> {
  database "==Datos persistentes\n<size:16>[Container: PostgreSQL en Amazon RDS]</size>\n\nHistorial, catálogos y evidencia; sesiones BFF en esquema y rol propios." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as Verificadordemensajes.Datospersistentes
  database "==Estado temporal y cuotas\n<size:16>[Container: Mismo RDS PostgreSQL; TTL y cuotas atómicas]</size>\n\nCasos con vencimiento, contexto y contadores compartidos entre réplicas." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as Verificadordemensajes.Estadotemporalycuotas
  rectangle "==Evaluador\n<size:16>[Container: Herramienta local o CI; por implementar]</size>\n\nEjecuta corpus sintético o saneado y produce métricas versionadas fuera del tráfico de usuarios." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Verificadordemensajes.Evaluador
  rectangle "==Web\n<size:16>[Container: SvelteKit / TypeScript / Tailwind; BFF Node.js]</size>\n\nConsulta abierta, resultado, seguimiento e historial privado." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Verificadordemensajes.Web
  rectangle "==API\n<size:16>[Container: Elixir / Phoenix; release OTP]</size>\n\nAcceso, análisis, conversación, cuotas e historial." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Verificadordemensajes.API
}

Personaqueconsulta --> Verificadordemensajes.Web <<Relationship-UmVsYXRpb25zaGlw>> : "Consulta y guarda casos\n<size:16>[HTTPS]</size>"
Verificadordemensajes.Web --> Verificadordemensajes.API <<Relationship-UmVsYXRpb25zaGlw>> : "Gestiona consultas\n<size:16>[HTTP / JSON; red Docker interna]</size>"
Verificadordemensajes.Web --> Serviciodeidentidad <<Relationship-UmVsYXRpb25zaGlw>> : "Gestiona acceso\n<size:16>[OIDC / Code + PKCE]</size>"
Verificadordemensajes.Web --> Verificadordemensajes.Datospersistentes <<Relationship-UmVsYXRpb25zaGlw>> : "Sesiones BFF cifradas\n<size:16>[PostgreSQL / TLS; rol propio]</size>"
Verificadordemensajes.API --> Serviciodeidentidad <<Relationship-UmVsYXRpb25zaGlw>> : "Obtiene claves públicas\n<size:16>[HTTPS / OIDC]</size>"
Verificadordemensajes.API --> ProveedordeIA <<Relationship-UmVsYXRpb25zaGlw>> : "Interpreta mensaje y comprobaciones\n<size:16>[HTTPS]</size>"
Verificadordemensajes.API --> Fuentesverificables <<Relationship-UmVsYXRpb25zaGlw>> : "Consulta evidencia\n<size:16>[HTTPS]</size>"
Verificadordemensajes.API --> Sitiosconsultados <<Relationship-UmVsYXRpb25zaGlw>> : "Comprueba raíces públicas; corte local\n<size:16>[HEAD / DNS e IP validados]</size>"
Verificadordemensajes.API --> Verificadordemensajes.Datospersistentes <<Relationship-UmVsYXRpb25zaGlw>> : "Lee y guarda datos\n<size:16>[Conexión protegida]</size>"
Verificadordemensajes.API --> Verificadordemensajes.Estadotemporalycuotas <<Relationship-UmVsYXRpb25zaGlw>> : "Casos y cuotas\n<size:16>[Conexión protegida]</size>"
Operador --> Verificadordemensajes.Evaluador <<Relationship-UmVsYXRpb25zaGlw>> : "Revisa calidad y costos"
Verificadordemensajes.Evaluador --> Verificadordemensajes.API <<Relationship-UmVsYXRpb25zaGlw>> : "Ejecuta corpus\n<size:16>[HTTP / fixtures]</size>"
Operador --> Verificadordemensajes.API <<Relationship-UmVsYXRpb25zaGlw>> : "Aprueba catálogos"

@enduml