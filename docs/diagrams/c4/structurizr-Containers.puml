@startuml
title <size:24>Contenedores lógicos del verificador de mensajes</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Container
  .Element-RWxlbWVudCxDb250YWluZXI= {
    BackgroundColor: #dbeafe;
    LineColor: #99a3b1;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #0f172a;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Database
  .Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U= {
    BackgroundColor: #dcfce7;
    LineColor: #9ab0a1;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #0f172a;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #1e3a8a;
    LineColor: #152860;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0= {
    BackgroundColor: #1d4ed8;
    LineColor: #143697;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Verificador de mensajes
  .Boundary-VmVyaWZpY2Fkb3IgZGUgbWVuc2FqZXM= {
    BackgroundColor: #ffffff;
    LineColor: #143697;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

person "==Persona que consulta\n<size:16>[Person]</size>\n\nEvalúa un mensaje y decide su siguiente acción, con o sin cuenta." <<Element-RWxlbWVudCxQZXJzb24=>> as Personaqueconsulta
person "==Operador\n<size:16>[Person]</size>\n\nMantiene fuentes, costos y funcionamiento sin leer mensajes en logs." <<Element-RWxlbWVudCxQZXJzb24=>> as Operador
rectangle "==Servicio de identidad\n<size:16>[Software System]</size>\n\nRegistro y acceso a cuentas; Cognito es el candidato sobre AWS." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Serviciodeidentidad
rectangle "==Proveedor de IA\n<size:16>[Software System]</size>\n\nInterpreta casos y seguimiento con respuesta estructurada y plazo máximo." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as ProveedordeIA
rectangle "==Fuentes verificables\n<size:16>[Software System]</size>\n\nPáginas oficiales de marcas, avisos SBS, feeds de phishing y RDAP, con procedencia." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Fuentesverificables

rectangle "Verificador de mensajes\n<size:16>[Software System]</size>" <<Boundary-VmVyaWZpY2Fkb3IgZGUgbWVuc2FqZXM=>> {
  database "==Datos persistentes\n<size:16>[Container: Base relacional; motor pendiente]</size>\n\nHistorial, marcas, dominios, canales, políticas, indicadores, avisos y versiones." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as Verificadordemensajes.Datospersistentes
  database "==Estado temporal y cuotas\n<size:16>[Container: Almacenamiento compartido; servicio pendiente]</size>\n\nCasos con vencimiento, contexto y contadores compartidos entre réplicas." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as Verificadordemensajes.Estadotemporalycuotas
  rectangle "==Evaluador\n<size:16>[Container: Herramienta local o CI; por implementar]</size>\n\nEjecuta corpus sintético o saneado y produce métricas versionadas fuera del tráfico de usuarios." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Verificadordemensajes.Evaluador
  rectangle "==Web\n<size:16>[Container: SvelteKit y Tailwind, propuesta de continuidad]</size>\n\nConsulta abierta, resultado, seguimiento e historial privado." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Verificadordemensajes.Web
  rectangle "==API\n<size:16>[Container: HTTP JSON; lenguaje pendiente]</size>\n\nAcceso, análisis, conversación, cuotas e historial." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Verificadordemensajes.API
}

Personaqueconsulta --> Verificadordemensajes.Web <<Relationship-UmVsYXRpb25zaGlw>> : "Consulta y guarda casos\n<size:16>[HTTPS]</size>"
Verificadordemensajes.Web --> Verificadordemensajes.API <<Relationship-UmVsYXRpb25zaGlw>> : "Gestiona casos e historial\n<size:16>[HTTPS / JSON]</size>"
Verificadordemensajes.Web --> Serviciodeidentidad <<Relationship-UmVsYXRpb25zaGlw>> : "Inicia acceso\n<size:16>[OIDC, propuesta]</size>"
Verificadordemensajes.API --> Serviciodeidentidad <<Relationship-UmVsYXRpb25zaGlw>> : "Obtiene claves públicas\n<size:16>[HTTPS / OIDC]</size>"
Verificadordemensajes.API --> ProveedordeIA <<Relationship-UmVsYXRpb25zaGlw>> : "Interpreta contexto minimizado\n<size:16>[HTTPS]</size>"
Verificadordemensajes.API --> Fuentesverificables <<Relationship-UmVsYXRpb25zaGlw>> : "Consulta evidencia\n<size:16>[HTTPS]</size>"
Verificadordemensajes.API --> Verificadordemensajes.Datospersistentes <<Relationship-UmVsYXRpb25zaGlw>> : "Lee y guarda datos\n<size:16>[Conexión protegida]</size>"
Verificadordemensajes.API --> Verificadordemensajes.Estadotemporalycuotas <<Relationship-UmVsYXRpb25zaGlw>> : "Casos y cuotas\n<size:16>[Conexión protegida]</size>"
Operador --> Verificadordemensajes.Evaluador <<Relationship-UmVsYXRpb25zaGlw>> : "Revisa calidad y costos"
Verificadordemensajes.Evaluador --> Verificadordemensajes.API <<Relationship-UmVsYXRpb25zaGlw>> : "Evalúa entorno de prueba\n<size:16>[HTTP / fixtures]</size>"
Operador --> Verificadordemensajes.API <<Relationship-UmVsYXRpb25zaGlw>> : "Aprueba catálogos"

@enduml