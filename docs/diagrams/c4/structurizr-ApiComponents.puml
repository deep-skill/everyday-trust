Verificadordemensajes.API.Casos --> Verificadordemensajes.API.Señalesverificables <<Relationship-UmVsYXRpb25zaGlw>> : "Analiza"
Verificadordemensajes.API.Señalesverificables --> Fuentesverificables <<Relationship-UmVsYXRpb25zaGlw>> : "Consulta evidencia\n<size:16>[HTTPS]</size>"
Verificadordemensajes.API.Señalesverificables --> Sitiosconsultados <<Relationship-UmVsYXRpb25zaGlw>> : "HEAD de raíz; revalida cada salto\n<size:16>[HTTP(S) / IP fijada]</size>"
Verificadordemensajes.API.Señalesverificables --> Verificadordemensajes.Datospersistentes <<Relationship-UmVsYXRpb25zaGlw>> : "Consulta snapshots y versiones"
Verificadordemensajes.API.Casos --> Verificadordemensajes.API.Políticaderiesgo <<Relationship-UmVsYXRpb25zaGlw>> : "Evalúa riesgo"
Verificadordemensajes.API.Casos --> Verificadordemensajes.API.Minimizacióndedatos <<Relationship-UmVsYXRpb25zaGlw>> : "Minimiza contexto"
Verificadordemensajes.API.Casos --> Verificadordemensajes.API.Interpretaciónyseguimiento <<Relationship-UmVsYXRpb25zaGlw>> : "Explica"
Verificadordemensajes.API.Interpretaciónyseguimiento --> Verificadordemensajes.API.Minimizacióndedatos <<Relationship-UmVsYXRpb25zaGlw>> : "Valida entrada y salida"
Verificadordemensajes.API.Interpretaciónyseguimiento --> ProveedordeIA <<Relationship-UmVsYXRpb25zaGlw>> : "Envía contexto completo del piloto\n<size:16>[HTTPS]</size>"
Verificadordemensajes.API.Casos --> Verificadordemensajes.Estadotemporalycuotas <<Relationship-UmVsYXRpb25zaGlw>> : "Mantiene etapas y contexto"
Verificadordemensajes.API.Historial --> Verificadordemensajes.Estadotemporalycuotas <<Relationship-UmVsYXRpb25zaGlw>> : "Comprueba caso y acceso"
Verificadordemensajes.API.Historial --> Verificadordemensajes.API.Minimizacióndedatos <<Relationship-UmVsYXRpb25zaGlw>> : "Restringe campos"
Verificadordemensajes.API.Historial --> Verificadordemensajes.Datospersistentes <<Relationship-UmVsYXRpb25zaGlw>> : "Gestiona datos del titular"
Operador --> Verificadordemensajes.API.Ingestadefuentes <<Relationship-UmVsYXRpb25zaGlw>> : "Aprueba catálogos"
Verificadordemensajes.API.Ingestadefuentes --> Fuentesverificables <<Relationship-UmVsYXRpb25zaGlw>> : "Obtiene snapshots\n<size:16>[HTTPS / fuentes configuradas]</size>"
Verificadordemensajes.API.Ingestadefuentes --> Verificadordemensajes.Datospersistentes <<Relationship-UmVsYXRpb25zaGlw>> : "Valida y publica versiones"

@enduml