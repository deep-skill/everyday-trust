@startuml
title <size:24>Componentes lógicos de la API</size>

set separator none
top to bottom direction
skinparam ranksep 60
skinparam nodesep 22
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Component
  .Element-RWxlbWVudCxDb21wb25lbnQ= {
    BackgroundColor: #eff6ff;
    LineColor: #a7acb2;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #0f172a;
