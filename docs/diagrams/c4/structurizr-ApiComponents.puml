    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container
  .Element-RWxlbWVudCxDb250YWluZXI= {
    BackgroundColor: #dbeafe;
    LineColor: #99a3b1;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #0f172a;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Database
  .Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U= {
    BackgroundColor: #dcfce7;
    LineColor: #9ab0a1;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #0f172a;
    FontSize: 24;
