    LineColor: #99a3b1;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #0f172a;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Container,Database
  .Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U= {
    BackgroundColor: #dcfce7;
    LineColor: #9ab0a1;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #0f172a;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Infrastructure Node
  .Element-RWxlbWVudCxJbmZyYXN0cnVjdHVyZSBOb2Rl {
    BackgroundColor: #fef3c7;
    LineColor: #b1aa8b;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #78350f;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Software System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0= {
    BackgroundColor: #1d4ed8;
    LineColor: #143697;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Element,Deployment Node
  .DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU= {
    BackgroundColor: #f8fafc;
    LineColor: #adafb0;
