  "components": {
    "schemas": {
      "Signal": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "message",
          "source",
          "checked_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "message": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_version": {
            "type": "string"
          },
          "source_published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Case": {
        "type": "object",
        "required": [
          "id",
          "verdict",
          "baseline_verdict",
          "risk_origin",
          "summary",
          "signals",
          "advice",
          "analysis_status",
          "coverage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "verdict": {
            "enum": [
              "high_risk",
              "suspicious",
              "no_signals_detected",
              "inconclusive"
            ]
          },
          "baseline_verdict": {
            "enum": [
              "high_risk",
              "suspicious",
              "no_signals_detected",
              "inconclusive"
            ]
          },
          "risk_origin": {
            "enum": [
              "rules",
              "interpretation"
            ]
          },
          "summary": {
            "type": "string"
          },
          "signals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Signal"
            }
          },
          "advice": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "analysis_status": {
            "const": "completed"
          },
          "analysis_mode": {
            "enum": [
              "signals",
              "signals_and_ai"
            ]
          },
          "coverage": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "schema_version": {
            "const": 1
          },
          "policy_version": {
            "type": "string"
          },
          "revision": {
            "const": 1
          },
          "scam_type": {
            "type": "string"
          },
          "rules_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "analyzed_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Saved": {
        "type": "object",
        "required": [
          "id",
          "result",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "result": {
            "$ref": "#/components/schemas/CaseSnapshot"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CaseSnapshot": {
        "type": "object",
        "description": "Evaluación sin id temporal ni expires_at. Mismos campos de resultado que Case."
      },
      "History": {
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Saved"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "Operation": {
        "type": "object"
      },
      "Followup": {
        "type": "object",
        "required": [
          "reply",
          "remaining_turns"
        ],
        "properties": {
          "reply": {
            "type": "string",
            "maxLength": 700
          },
          "remaining_turns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        }
      },
      "TractionTotals": {
        "type": "object",
        "required": [
          "visits",
          "consultations",
          "reviews",
          "rating"
        ],
        "properties": {
          "visits": {
            "type": "integer",
            "minimum": 0
          },
          "consultations": {
            "type": "integer",
            "minimum": 0
          },
          "reviews": {
            "type": "integer",
            "minimum": 0
          },
          "rating": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "securitySchemes": {
      "ServiceToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Token"
      },
      "VisitorSession": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Session-Id"
      },
      "CognitoAccess": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
