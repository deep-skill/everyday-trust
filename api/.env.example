# Inject through Compose or your shell. Mix does not load this file automatically.
DATABASE_URL=postgres://postgres:local-development-only@db/everyday_trust_dev
API_SERVICE_TOKEN=local-development-service-token-only
PHX_SERVER=true
NETWORK_CHECKS=true
COGNITO_ISSUER=
COGNITO_CLIENT_ID=

# Enable Meta only for the internal hackathon pilot approved by JP.
AI_PROVIDER=disabled
AI_DATA_APPROVED=false
AI_INPUT_MODE=full_context
DEEPSEEK_API_KEY=
MODEL_API_KEY=

# Required in a production release.
SECRET_KEY_BASE=
DATABASE_CA_FILE=

# Optional pilot improvements; keep disabled until the deployed flow is verified.
SAFE_BROWSING_ENABLED=false
GOOGLE_SAFE_BROWSING_API_KEY=
URLSCAN_ENABLED=false
URLSCAN_API_KEY=
REPORT_ACTIONS_ENABLED=false
IMAGE_INPUT_ENABLED=false
COMMUNITY_REPORTS_ENABLED=false
