# Inject through Compose or your shell. Mix does not load this file automatically.
DATABASE_URL=postgres://postgres:local-development-only@db/everyday_trust_dev
API_SERVICE_TOKEN=local-development-service-token-only
PHX_SERVER=true
NETWORK_CHECKS=true
COGNITO_ISSUER=
COGNITO_CLIENT_ID=

# Disabled until provider, credentials and treatment of real messages are agreed.
AI_PROVIDER=disabled
AI_DATA_APPROVED=false
DEEPSEEK_API_KEY=
MODEL_API_KEY=

# Required in a production release.
SECRET_KEY_BASE=
DATABASE_CA_FILE=
